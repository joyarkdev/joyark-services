{
    "name": "joyarkdev/joyark-services",
    "description": "This is my package joyark-services",
    "keywords": [
        "joyarkdev",
        "laravel",
        "joyark-services"
    ],
    "homepage": "https://github.com/joyarkdev/joyark-services",
    "license": "MIT",
    "authors": [
        {
            "name": "Victor Tang",
            "email": "tanghengzhi@live.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/contracts": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.14.0",
        "stevebauman/location": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Joyarkdev\\JoyarkServices\\": "src/",
            "Joyarkdev\\JoyarkServices\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joyarkdev\\JoyarkServices\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joyarkdev\\JoyarkServices\\JoyarkServicesServiceProvider"
            ],
            "aliases": {
                "JoyarkServices": "Joyarkdev\\JoyarkServices\\Facades\\JoyarkServices"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
